rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // DEMO-ONLY rules for a supervised college demonstration.
    // There is no user authentication in this prototype, so anyone who knows
    // the site can read/write these collections. NOT for a real restaurant.

    match /restaurants/{id}         { allow read, write: if true; }
    match /tables/{id}              { allow read, write: if true; }
    match /menuItems/{id}           { allow read, write: if true; }
    match /bookings/{id}            { allow read, write: if true; }
    match /orders/{id}              { allow read, write: if true; }
    match /payments/{id}            { allow read, write: if true; }
    match /users/{id}               { allow read, write: if true; }
    match /meta/{id}                { allow read, write: if true; }
    match /recommendationData/{id}  { allow read, write: if true; }
  }
}
