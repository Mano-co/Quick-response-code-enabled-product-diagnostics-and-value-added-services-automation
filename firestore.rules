rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // DEMO-LEVEL RULES for a supervised college demonstration.
    // There is NO user authentication in this prototype, so anyone who knows the site
    // can read/write. These rules only stop obviously invalid data (bad status values,
    // negative stock/prices, edited or deleted payment records). NOT for a real restaurant.

    match /restaurants/{id} { allow read, write: if true; }

    match /tables/{id} {
      allow read: if true;
      allow write: if request.resource.data.status in ['available','reserved','occupied','cleaning'];
    }

    match /menuItems/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.stock is int && request.resource.data.stock >= 0
                            && request.resource.data.price is number && request.resource.data.price > 0;
      allow delete: if true;
    }

    match /bookings/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.status in ['CONFIRMED','CHECKED_IN','COMPLETED','CANCELLED'];
      allow delete: if false;
    }

    match /orders/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.status in ['NEW','ACCEPTED','PREPARING','READY','SERVED','COMPLETED','CANCELLED']
                            && request.resource.data.total >= 0;
      allow delete: if false;
    }

    // payment records are write-once (cannot be edited or deleted afterwards)
    match /payments/{id} {
      allow read: if true;
      allow create: if request.resource.data.amount >= 0;
      allow update, delete: if false;
    }

    match /users/{id}              { allow read, write: if true; }
    match /meta/{id}               { allow read: if true; allow write: if request.resource.data.n is int; }
    match /recommendationData/{id} { allow read, write: if true; }
  }
}
